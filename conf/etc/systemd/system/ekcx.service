[Unit]
Description=EKCXWeb
After=network.target

[Service]
User=jdog
WorkingDirectory=/home/jdog/ekcx-web
Environment=EKCX_DB_PATH=/home/jdog/ekcx-web/var/ekcx.sqlite3
LimitNOFILE=4096
ExecStart=/home/jdog/.local/bin/uv run gunicorn main:app --workers 2 -k worker.MyUvicornWorker --bind unix:ekcx.sock --error-logfile /var/log/ekcx/error_log.txt
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target