server {
    listen [::]:80;
    listen 80;
    server_name dev.ekcx.co.uk;

    # Certbot webroot is /usr/share/nginx/html; do not redirect ACME challenges.
    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen [::]:443 ssl http2;
    listen 443 ssl http2;
    server_name dev.ekcx.co.uk;
    access_log /var/log/nginx/dev-ekcx.access.log;
    error_log /var/log/nginx/dev-ekcx.error.log;

    keepalive_timeout 5;
    client_max_body_size 4G;

    ssl_certificate /etc/letsencrypt/live/dev.ekcx.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.ekcx.co.uk/privkey.pem;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        proxy_pass http://unix:/home/jdog/ekcx-dev/dev-ekcx.sock;
        proxy_connect_timeout       75s;
        proxy_send_timeout          75s;
        proxy_read_timeout          75s;
        send_timeout                75s;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Host $server_name;
        proxy_set_header HOST $http_host;
    }
}